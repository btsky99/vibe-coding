{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-frontend",
      "cwd": ".ai_monitor/vibe-view",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "python-main-server",
      "runtimeExecutable": "python",
