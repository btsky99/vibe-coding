{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/vibe-coding/scripts/gemini_hook.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/vibe-coding/gemini_statusline.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/vibe-coding/scripts/gemini_hook.py",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "D:/vibe-coding/.ai_monitor/data/hive_mind.db"
      ]
    },
    "vibe-coding": {
      "command": "D:/vibe-coding/.ai_monitor/venv/Scripts/python.exe",
      "args": [
        "D:/vibe-coding/.ai_monitor/bin/mcp_server.py"
      ],
      "env": {
        "PROJECT_ROOT": "D:/vibe-coding"
      }
    }
  },
  "ui": {
    "hideContextSummary": true,
    "footer": {
      "hideContextPercentage": false
    }
  }
}